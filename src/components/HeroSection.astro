---
import { Image } from "astro:assets";
import lipColor from "../assets/campaign/signature-lip-color.png";
import foundation from "../assets/campaign/foundation-shade-match.png";

const whatsappHref = `https://wa.me/18456708740?text=${encodeURIComponent("Hi Estela! I'd love to find my custom makeup shade. Can we arrange a consultation?")}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="intro-grid">
    <div class="intro-copy">
      <p class="eyebrow" data-animate>Custom lipstick &amp; foundation</p>
      <h1 id="hero-title" class="intro-title">
        <span data-reveal-line>Your color.</span>
        <span data-reveal-line><em>Made personal.</em></span>
      </h1>
      <p class="intro-description" data-animate>
        Fall in love with a shade that feels like you. Custom lipstick and foundation,
        blended in New York around your skin tone, finish and style.
      </p>
      <div class="intro-actions" data-animate>
        <a class="button button-primary" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-contact-placement="hero" aria-label="Find my shade: chat with Estela on WhatsApp (opens in a new tab)">
          Find my shade <span aria-hidden="true">↗</span>
        </a>
        <a class="intro-secondary" href="#services">Explore custom makeup <span aria-hidden="true">↓</span></a>
      </div>
      <div class="intro-personal-note" data-animate>
        <span class="intro-swatches" aria-hidden="true"><i></i><i></i><i></i></span>
        <p>One-to-one with <strong>Estela Schmidt</strong><br /><span>NY Licensed Esthetician</span></p>
      </div>
    </div>

    <div class="intro-visual" data-animate>
      <div class="intro-portrait-frame">
        <Image src={lipColor} alt="Beauty portrait with a rose lip color and a matching lipstick" class="hero-portrait" widths={[480, 720, 1120]} sizes="(max-width: 720px) 86vw, (max-width: 1020px) 60vw, 43vw" loading="eager" fetchpriority="high" decoding="async" quality={86} />
      </div>
      <a class="intro-match-card" href="#services" aria-label="Explore custom foundation shade matching">
        <Image src={foundation} alt="Foundation undertones compared on skin" widths={[240, 420]} sizes="(max-width: 720px) 40vw, 220px" loading="eager" decoding="async" quality={82} />
        <span>Your skin. Your match. <span aria-hidden="true">↗</span></span>
      </a>
      <span class="intro-caption">A shade to call your own.</span>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding: calc(var(--header-height) + 3rem) max(1.25rem, 5vw) 3.5rem;
    background: radial-gradient(ellipse at 88% 38%, #e9c4b7 0%, transparent 55%), #fbf2eb;
    border-bottom: 1px solid #e6cfc6;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    max-width: 1240px;
    margin: auto;
  }

  .intro-copy { padding-block: 1rem; }
  .eyebrow { letter-spacing: 0.1em; font-size: 0.7rem; }

  .intro-title {
    margin: 1.25rem 0 0;
    font: 600 clamp(4rem, 6.8vw, 6.5rem) / 0.97 "Cormorant Garamond", Georgia, serif;
    letter-spacing: -0.045em;
    color: var(--color-wine);
  }

  .intro-title span { display: block; }
  .intro-title em { font-weight: 500; color: #a84459; }

  .intro-description {
    max-width: 27rem;
    margin: 1.6rem 0 0;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .intro-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.3rem 1.5rem; margin-top: 2rem; }
  .intro-actions .button { gap: 1.5rem; padding: 1rem 1.5rem; min-height: 3.4rem; text-transform: none; font-size: 0.9rem; }
  .intro-actions .button span { font-size: 1.25rem; }
  .intro-secondary { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; border-bottom: 1px solid #b99a95; font-size: 0.82rem; font-weight: 500; }
  .intro-secondary:hover { color: var(--color-berry); border-color: currentColor; }
  .intro-secondary:focus-visible, .intro-match-card:focus-visible { outline: 3px solid var(--color-berry); outline-offset: 5px; }

  .intro-personal-note { display: flex; align-items: center; gap: 0.9rem; margin-top: 2.4rem; }
  .intro-personal-note p { margin: 0; font-size: 0.72rem; line-height: 1.75; color: var(--color-muted); }
  .intro-personal-note strong { color: var(--color-wine); font-weight: 600; }
  .intro-personal-note p > span { font-size: 0.65rem; }
  .intro-swatches { display: flex; padding-left: 0.35rem; }
  .intro-swatches i { width: 1.5rem; height: 1.5rem; margin-left: -0.35rem; border: 2px solid #fbf2eb; border-radius: 50%; background: #a43e51; }
  .intro-swatches i:nth-child(2) { background: #ce8774; }
  .intro-swatches i:nth-child(3) { background: #dbb292; }

  .intro-visual { position: relative; min-width: 0; padding: 0 0 2.25rem 2.6rem; }
  .intro-portrait-frame { overflow: hidden; border-radius: 45% 45% 5px 5px; aspect-ratio: 0.82; background: #cc9f87; }
  .hero-portrait { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .intro-match-card { position: absolute; width: 43%; max-width: 14rem; left: -0.6rem; bottom: 4.2rem; padding: 0.45rem; background: #fffaf6; box-shadow: 0 12px 40px #4b07151f; transform: rotate(-4deg); transition: transform 200ms ease; }
  .intro-match-card:hover { transform: rotate(-1deg) translateY(-3px); }
  .intro-match-card img { width: 100%; height: auto; aspect-ratio: 1.4; object-fit: cover; }
  .intro-match-card > span { display: flex; justify-content: space-between; align-items: center; gap: 0.4rem; padding: 0.65rem 0.3rem 0.25rem; font: 600 1.05rem / 1.15 "Cormorant Garamond", Georgia, serif; }
  .intro-caption { position: absolute; bottom: 0; right: 0; font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }

  @media (max-width: 1020px) {
    .intro-grid { grid-template-columns: 1fr 0.9fr; gap: 2rem; }
    .intro-title { font-size: clamp(3.5rem, 7vw, 5.2rem); }
    .intro-actions { gap: 0.7rem 1rem; }
    .intro-visual { padding-left: 1rem; }
    .intro-match-card { width: 50%; }
  }

  @media (max-width: 720px) {
    .hero { padding: calc(var(--header-height) + 1.75rem) 1.25rem 2.5rem; }
    .intro-grid { grid-template-columns: 1fr; gap: 2rem; }
    .intro-copy { padding: 0; }
    .eyebrow { font-size: 0.64rem; }
    .intro-title { margin-top: 0.9rem; font-size: clamp(3.15rem, 12.7vw, 5.5rem); line-height: 1; }
    .intro-description { margin-top: 1.15rem; font-size: 0.92rem; line-height: 1.75; }
    .intro-actions { margin-top: 1.4rem; }
    .intro-actions .button { width: auto; min-height: 3.1rem; padding: 0.8rem 1.1rem; gap: 0.8rem; }
    .intro-secondary { font-size: 0.74rem; gap: 0.35rem; }
    .intro-personal-note { margin-top: 1.4rem; }
    .intro-visual { width: min(420px, 100%); margin: auto; padding-left: 1.6rem; }
    .intro-portrait-frame { aspect-ratio: 0.95; }
    .intro-match-card { width: 43%; bottom: 3.6rem; left: 0; }
    .intro-match-card > span { font-size: 0.85rem; }
    .intro-caption { font-size: 0.58rem; }
  }
</style>
